rules_version = '2';

// Cloud Firestore Security Rules
// ----------------------------------------------------------------------------
// P.V.K.N. Workshop Portal — STJR 2026
//
// Pattern:
//   • `registrations/`     — public CREATE with strict field validation;
//                            READ / UPDATE / DELETE restricted to signed-in admins.
//   • Everything else      — denied by default.
//
// Deploy with:
//   firebase deploy --only firestore:rules
// ----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from a signed-in admin?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: is this a brand-new document (CREATE only)?
    function isNewDoc() {
      return request.method == 'create';
    }

    // Allowed course values
    function isValidCourse(v) {
      return v in ['B.Sc.', 'B.A.', 'B.Com.', 'BBA', 'BCA'];
    }

    // Allowed year values
    function isValidYear(v) {
      return v in ['1st Year', '2nd Year', '3rd Year'];
    }

    // Allowed participation values
    function isValidParticipation(v) {
      return v in ['Day 1 Only', 'Day 2 Only', 'Both Days'];
    }

    // Allowed gender values
    function isValidGender(v) {
      return v in ['Male', 'Female', 'Prefer not to say'];
    }

    // Field-level validation for a registration payload
    function isValidRegistration(data) {
      return data.keys().hasAll([
          'registrationId', 'registrationSeq', 'fullName', 'studentId',
          'course', 'year', 'mobile', 'email', 'gender', 'participation',
          'createdAt'
        ])
        && data.registrationId is string
        && data.registrationId.size() > 0
        && data.registrationId.size() <= 32
        && data.registrationSeq is int
        && data.registrationSeq >= 1
        && data.registrationSeq <= 9999
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 80
        && data.studentId is string
        && data.studentId.size() >= 4
        && data.studentId.size() <= 20
        && isValidCourse(data.course)
        && isValidYear(data.year)
        && data.mobile is string
        && data.mobile.size() == 10
        && data.email is string
        && data.email.matches('.*@.*\\..*')
        && isValidGender(data.gender)
        && isValidParticipation(data.participation)
        && data.createdAt is string;
    }

    match /registrations/{regId} {

      // Public can CREATE a new registration, but only with valid fields.
      // The same document cannot be re-created (admin auth required for any
      // subsequent read/update/delete).
      allow create: if isNewDoc()
                    && isValidRegistration(request.resource.data);

      // Only signed-in admins (any authenticated user — see note below) can
      // read or modify existing records.
      //
      // ⚠️  IMPORTANT: this currently allows ANY signed-in Firebase Auth user
      // to read registrations. If you have multiple Firebase Auth users who
      // are NOT workshop admins, tighten this with custom claims:
      //
      //   function isAdmin() {
      //     return request.auth != null
      //       && request.auth.token.admin == true;
      //   }
      //   allow read, update, delete: if isAdmin();
      //
      // Then set the claim from the Firebase Admin SDK (server side) for each
      // admin account, e.g. auth.setCustomUserClaims(uid, { admin: true }).
      allow read, update, delete: if isSignedIn();
    }

    // Sequence counter used to allocate unique registration IDs atomically
    // (see js/registration.js → createRegistrationAtomically). Public needs
    // to be able to read+write this single doc so the transaction works.
    // We restrict it to the exact shape we expect: a single integer field
    // `registrationSeq` that is strictly greater than the existing value
    // (prevents accidental rewinds if rules are misconfigured).
    match /metadata/counters/{counterId} {
      allow read, create, update: if counterId == 'counters'
                                   && request.resource.data.keys().hasOnly(['registrationSeq'])
                                   && request.resource.data.registrationSeq is int
                                   && request.resource.data.registrationSeq >= 1
                                   && (!exists(/databases/$(database)/documents/metadata/counters/$(counterId))
                                       || request.resource.data.registrationSeq
                                          > resource.data.registrationSeq);
      allow delete: if false;
    }

    // Default-deny for any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
